{
  "name": "@uwpk/pi-bridge",
  "version": "0.3.0",
  "description": "Portable Codex to Pi bridge with skill, CLI and stdio MCP interfaces",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-bridge": "bin/pi-bridge.mjs",
    "pi-bridge-mcp": "bin/pi-bridge-mcp.mjs"
  },
  "files": [
    "bin",
    "dist/src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test --test-timeout=120000 dist/tests/unit/*.test.js",
    "test:integration": "node --test --test-timeout=120000 dist/tests/integration/*.test.js",
    "test:smoke": "node --test --test-timeout=300000 dist/tests/smoke/*.test.js",
    "test": "npm run build && npm run test:unit && npm run test:integration && npm run test:portable",
    "prepack": "npm run build",
    "test:portable": "node --test --test-timeout=120000 tests/portable/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UWPK/pi-bridge.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.6.3"
  }
}
